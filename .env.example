# ── Local Supabase (Docker) ─────────────────────────────────────────
# Values shown when you run `npx supabase status` after `npx supabase start`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<paste from `npx supabase status` → "anon key">
# Only needed by server-side scripts (seed, imports, PDF render). Never import
# this in a "use client" file.
SUPABASE_SERVICE_ROLE_KEY=<paste from `npx supabase status` → "service_role key">

# Direct Postgres connection (port 54322, not the 54321 API port). Used by
# scripts/setup-demo-schema.mjs and by `psql` when bootstrapping from
# scripts/schema.sql.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ── Google Sheet sync ───────────────────────────────────────────────
# Optional shared secret. If you fill this in, the same value must be set as
# the Apps Script script property "SYNC_TOKEN", otherwise every sync call is
# rejected (google-script/Code.js → isAuthorized). Leave blank to accept
# calls without a token; that is only sensible on your own machine.
SYNC_TOKEN=

# ── WhatsApp reminders (Meta Cloud API through the 1automations CRM proxy) ─────
# The Faculty page and the profile panel send the approved template
# "dermacon_commitment_reminder" (en). The template has one body variable, the
# doctor's name, so nothing else is composed here.
#
# The bearer token is the CRM token, NOT the WhatsApp access token:
#   Authorization: Bearer <WHATSAPP_TOKEN>
# Never commit it. Keep it in .env.local only, and restart `npm run dev` after
# changing these values (server actions read them at request time, but the
# running process must see the new environment).
WHATSAPP_API_URL=https://crmapi.1automations.com/api/meta
WHATSAPP_API_VERSION=v19.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1101670236354895
WHATSAPP_TEMPLATE_NAME=dermacon_commitment_reminder
WHATSAPP_TEMPLATE_LANG=en
# Optional: the name shown in the app ("sending from ...").
WHATSAPP_SENDER_DISPLAY=Dermacon 2027
# Optional: while set, EVERY message goes to this number and nobody is marked as
# WhatsApp'd. Use it for a dry run, then delete the line to send for real.
WHATSAPP_TEST_TO=
