# ── Local Supabase (Docker) ─────────────────────────────────────────
# Value shown when you run `npx supabase status` after `npx supabase start`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<paste from `npx supabase status` → "anon key">
# Only needed by server-side scripts (PDF render, seed). Never import
# this in a "use client" file.
SUPABASE_SERVICE_ROLE_KEY=<paste from `npx supabase status` → "service_role key">

# ── Optional ────────────────────────────────────────────────────────
# Base URL used by print/PDF endpoints
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public app origin used for absolute faculty venue-route links in emails.
# Set the production value in Vercel, for example https://your-project.vercel.app
APP_PUBLIC_URL=https://dermacon2027.vercel.app/
